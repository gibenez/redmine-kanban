# Only the JSON operations needed by this board are proxied.
map "$request_method:$uri" $board_api_allowed {
    default 0;
    ~^GET:/redmine/(users/current|issue_statuses|enumerations/issue_priorities|projects|projects/[0-9]+|projects/[0-9]+/(versions|memberships)|issues|issues/[0-9]+|issues/[0-9]+/relations|versions/[0-9]+)\.json$ 1;
    ~^PUT:/redmine/issues/[0-9]+\.json$ 1;
    ~^POST:/redmine/issues/[0-9]+/relations\.json$ 1;
    ~^POST:/redmine/issues\.json$ 1;
    ~^DELETE:/redmine/relations/[0-9]+\.json$ 1;
}

server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    server_tokens off;
    client_max_body_size 32k;
    # data: in img-src covers the inline SVG background icons in the compiled stylesheet; data URIs cannot fetch resources or run script.
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header Cache-Control 'no-store' always;

    location = /health { access_log off; return 200 'ok'; }
    location = /config.json { try_files $uri =404; }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }

    location /redmine/ {
        if ($board_api_allowed = 0) { return 404; }
        access_log off;
        # Never retain personal keys or authenticated responses in a proxy cache.
        proxy_cache off;
        proxy_pass ${REDMINE_URL}/;
        proxy_ssl_server_name on;
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/cert.pem;
        proxy_set_header Host $proxy_host;
        proxy_set_header Cookie '';
        proxy_set_header Authorization '';
        proxy_set_header X-Redmine-API-Key $http_x_redmine_api_key;
        # Do not allow a client to impersonate another Redmine user.
        proxy_set_header X-Redmine-Switch-User '';
        proxy_hide_header Set-Cookie;
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Cache-Control;
        proxy_redirect off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 25s;
        add_header Cache-Control 'no-store' always;
        add_header Content-Security-Policy "sandbox; default-src 'none'; frame-ancestors 'none'" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }
}
