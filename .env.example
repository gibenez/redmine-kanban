# Your existing Redmine URL, reachable from the board container and browser.
# No shared Docker network is required. No trailing slash.
REDMINE_URL=https://redmine.example.com
# Discover actual IDs using GET /issue_statuses.json with your personal API key.
BACKLOG_STATUS_ID=1
COLUMN_STATUS_IDS=1,2,3,5
REFRESH_SECONDS=60
BOARD_PORT=8080
