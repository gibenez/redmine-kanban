# Your existing Redmine URL, reachable from the board container and browser.
# No shared Docker network is required. No trailing slash.
REDMINE_URL=https://redmine.example.com
# Discover actual IDs using GET /issue_statuses.json with your personal API key.
BACKLOG_STATUS_ID=1
COLUMN_STATUS_IDS=1,2,3,5
REFRESH_SECONDS=60
# version (default) or build (sprints are Build issues, grouped by Category).
SPRINT_SOURCE=version
# Optional: enabled Build tracker ID. If blank, resolve the exact name Build per project.
BUILD_TRACKER_ID=
# Exact tracker names rendered as Swimlanes. Set empty to disable grouping.
SWIMLANE_TRACKERS=Feature,Bug,Improvement
BOARD_PORT=8080
# Production build source: Git URL with optional #branch/tag/commit, or . for local source.
BOARD_BUILD_CONTEXT=https://github.com/gibenez/redmine-kanban.git#main
